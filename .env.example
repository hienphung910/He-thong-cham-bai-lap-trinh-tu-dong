# =====================================================================
#  CodeHub - mau cau hinh moi truong
# =====================================================================
#  Chep file nay thanh `.env` roi dien gia tri that:
#
#      Windows PowerShell :  Copy-Item .env.example .env
#      Linux / macOS      :  cp .env.example .env
#
#  File `.env` da nam trong .gitignore nen mat khau khong bi day len git.
#  Bien moi truong that (export / $env:) LUON duoc uu tien hon file .env.
#
#  Truoc do nho tao CSDL va tai khoan oj_app:
#      mysql -u root -p < database/mysql/01_create_database.sql
# =====================================================================

# --- Ket noi MySQL (bo qua neu chay voi --no-db) ---
OJ_DB_URL=jdbc:mysql://localhost:3306/online_judge?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
OJ_DB_USER=oj_app
OJ_DB_PASSWORD=change_me

# --- Mat khau tai khoan quan tri, chi dung O LAN CHAY DAU TIEN ---
# Bo trong thi chuong trinh tu sinh mat khau ngau nhien: che do --no-db in ra terminal dung
# mot lan; chay voi CSDL that thi ghi vao data/admin-password.txt (khong in ra log).
# Cac lan chay sau khong bao gio dat lai mat khau admin.
OJ_ADMIN_PASSWORD=change_me_too

# --- Mat khau chung cua 4 tai khoan mau, chi dung khi bang users con trong ---
# KHONG co mat khau mac dinh. Bo trong khi chay voi CSDL that thi khong tao tai khoan mau.
OJ_SEED_PASSWORD=change_me_too

# =====================================================================
#  Chi dung khi dua len mang (Docker / Railway).
# =====================================================================
# OJ_BIND_ADDRESS=0.0.0.0     # dia chi lang nghe; bo trong = chi 127.0.0.1 (Dockerfile da dat san)
# OJ_ALLOW_REGISTER=false     # true / false: mo hay khoa tu dang ky luc khoi dong. Bo trong = mo, tru khi may chu
#                             # mo ra mang ma viec co lap bai nop khong bat duoc (luc do mac dinh khoa).
#                             # Khi mo: hoc sinh dang ky la dung duoc ngay, giang vien phai cho admin duyet.
# OJ_PERSIST_STATE=true       # chi can voi --no-db: luu lop hoc, ky thi... xuong data/state (che do MySQL luon luu)
# OJ_BANNED_WORDS=tu1, tu 2   # tu cam bo sung cho bo loc binh luan (ngoai danh sach co san), cach nhau dau phay
# OJ_SANDBOX_USER=ojrunner    # tai khoan he thong de chay bai nop (Dockerfile da dat san va da tao tai khoan nay)
# OJ_TRUST_PROXY=true         # may chu dung sau reverse proxy: lay dia chi nguoi dung tu X-Forwarded-For (Dockerfile da dat san)
#                             # dat "cloudflare" neu co Cloudflare dung truoc: lay dia chi tu CF-Connecting-IP
# OJ_ORIGIN_SECRET=...        # chi nhan request co header X-Origin-Secret dung chuoi nay (Cloudflare Transform Rule gan vao)
# OJ_TURNSTILE_SITE_KEY=...   # CAPTCHA Cloudflare Turnstile cho form dang nhap va dang ky: dat ca hai khoa thi bat
# OJ_TURNSTILE_SECRET=...
#
# Quen mat khau qua email (Resend - https://resend.com). Dat CA BA bien thi form dang nhap hien "Quen mat khau?":
# RESEND_API_KEY=re_...       # khoa API loai "Sending access", gioi han trong ten mien gui thu. KHONG dua khoa nay len git
# OJ_MAIL_FROM=CodeHub <no-reply@mail.example.com>   # nguoi gui; ten mien phai da xac minh o Resend
# OJ_PUBLIC_URL=https://example.com                  # dia chi trang web, dung de dung link trong thu
#
# Ket noi MySQL cua Aiven bat buoc SSL, dung sslMode=REQUIRED thay cho useSSL=false:
# OJ_DB_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
